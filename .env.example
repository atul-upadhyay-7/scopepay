# Sandbox only. Never paste secrets into chat or commit a filled .env.
# Copy to .env and fill locally: cp .env.example .env

# Server
PORT=8090
APP_ORIGIN=http://localhost:5173

# Local PostgreSQL (see docs/LOCAL_RUN.md for the free podman setup)
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/scopepay
DATABASE_USER=scopepay
DATABASE_PASSWORD=scopepay-local

# PayPal Developer SANDBOX app credentials (https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox dashboard (Notifications > Webhooks).
# Without it the webhook endpoint answers WEBHOOK_NOT_CONFIGURED and processes nothing.
PAYPAL_WEBHOOK_ID=

# Free plan only. Keep these false/blank until Free status and ZDR are verified.
GROQ_API_KEY=
GROQ_FREE_PLAN_CONFIRMED=false
AI_SYNTHETIC_ONLY=true

# Safety gates - keep these values for the demo
REQUIRE_REVIEWED_SCOPE=true
# Demo-only tools (webhook simulator, failure injection). Never true outside a local demo.
DEMO_TOOLS=false
